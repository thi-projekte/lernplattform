FROM node:22-slim AS build-stage

WORKDIR /app

ARG VITE_KEYCLOAK_URL
ARG VITE_KEYCLOAK_REALM
ARG VITE_KEYCLOAK_CLIENT_ID
ARG VITE_MYND_BACKEND_URI
ARG VITE_ANALYTICS_URI
ARG VITE_ANALYTICS_INSTANCE
ARG VITE_SENTRY_DSN


ENV VITE_KEYCLOAK_URL=$VITE_KEYCLOAK_URL
ENV VITE_KEYCLOAK_REALM=$VITE_KEYCLOAK_REALM
ENV VITE_KEYCLOAK_CLIENT_ID=$VITE_KEYCLOAK_CLIENT_ID
ENV VITE_MYND_BACKEND_URI=$VITE_MYND_BACKEND_URI
ENV VITE_ANALYTICS_URI=$VITE_ANALYTICS_URI
ENV VITE_ANALYTICS_INSTANCE=$VITE_ANALYTICS_INSTANCE
ENV VITE_SENTRY_DSN=$VITE_SENTRY_DSN

COPY package*.json ./
RUN npm install --platform=linux --arch=x64

COPY . .
RUN npm run build

FROM nginx:stable-alpine AS production-stage

COPY nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build-stage /app/dist /usr/share/nginx/html

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]